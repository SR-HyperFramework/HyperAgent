{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dynamic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "sample",
    "status",
    "summary",
    "findings",
    "artifacts",
    "investigation_targets",
    "limitations",
    "upstream_inputs",
    "runtime",
    "behaviors",
    "iocs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "stage": {
      "const": "dynamic"
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_sha256",
        "target_path",
        "target_sha256"
      ],
      "properties": {
        "original_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "target_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed",
        "not_needed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "investigation_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "upstream_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "guest_only",
        "aslr_base",
        "stop_reason",
        "observation_window"
      ],
      "properties": {
        "executed": {
          "type": "boolean"
        },
        "guest_only": {
          "const": true
        },
        "aslr_base": {
          "type": [
            "string",
            "null"
          ]
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "observation_window": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "status",
          "confidence",
          "description",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "enum": [
              "observed",
              "not_observed",
              "partial",
              "blocked",
              "unknown"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "iocs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "host",
        "persistence"
      ],
      "properties": {
        "network": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "persistence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "artifact",
        "location"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "observation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "static",
            "dynamic",
            "memory",
            "artifact",
            "tool_output",
            "external",
            "analyst"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "observation": {
          "type": "string"
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "status",
        "confidence",
        "description",
        "reasoning",
        "sources",
        "evidence",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "enum": [
            "sample_identity",
            "packing",
            "loader",
            "execution",
            "anti_analysis",
            "persistence",
            "filesystem",
            "registry",
            "process",
            "injection",
            "network",
            "credential_access",
            "collection",
            "exfiltration",
            "impact",
            "configuration",
            "ioc",
            "other"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "confirmed",
            "partial",
            "inferred",
            "hypothesized",
            "not_observed",
            "contradicted",
            "rejected",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "description": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "target",
        "reason",
        "recommended_action",
        "success_criteria"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "target": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "recommended_action": {
          "type": "string"
        },
        "success_criteria": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "type",
        "validation_status",
        "context"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "type": {
          "type": "string"
        },
        "validation_status": {
          "enum": [
            "validated",
            "partial",
            "failed",
            "not_validated",
            "not_applicable"
          ]
        },
        "context": {
          "type": "string"
        }
      }
    }
  }
}