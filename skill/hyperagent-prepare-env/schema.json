{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HyperAgent Prepare Environment Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "sample",
    "workspace",
    "static_environment",
    "dynamic_environment",
    "readiness",
    "blockers",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "stage": {
      "const": "prepare-env"
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "absolute_path",
        "sha256"
      ],
      "properties": {
        "file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "absolute_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_directory",
        "artifact_directory"
      ],
      "properties": {
        "report_directory": {
          "type": "string"
        },
        "artifact_directory": {
          "type": "string"
        }
      }
    },
    "static_environment": {
      "$ref": "#/$defs/environment"
    },
    "dynamic_environment": {
      "$ref": "#/$defs/environment"
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static",
        "dynamic",
        "overall"
      ],
      "properties": {
        "static": {
          "$ref": "#/$defs/readiness"
        },
        "dynamic": {
          "$ref": "#/$defs/readiness"
        },
        "overall": {
          "$ref": "#/$defs/readiness"
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "readiness": {
      "enum": [
        "ready",
        "partial",
        "blocked",
        "not_required",
        "unknown"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "components"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/readiness"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "detail"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "available",
                  "unavailable",
                  "not_configured",
                  "unknown"
                ]
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "code",
        "description",
        "recoverable"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "static",
            "dynamic",
            "workspace",
            "sample",
            "other"
          ]
        },
        "code": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "recoverable": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "location"
      ],
      "properties": {
        "type": {
          "enum": [
            "file",
            "command",
            "tool",
            "manual"
          ]
        },
        "location": {
          "type": "string"
        }
      }
    }
  }
}