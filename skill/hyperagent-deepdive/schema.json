{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HyperAgent Deepdive Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "sample_sha256",
    "status",
    "executive_assessment",
    "finding_reviews",
    "contradictions",
    "hypotheses",
    "root_cause_analysis",
    "investigation_targets",
    "final_claim_policy",
    "limitations",
    "upstream_inputs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "stage": {
      "const": "deepdive"
    },
    "sample_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "executive_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "confidence",
        "technical_summary",
        "highest_value_resolution",
        "remaining_decision_point"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "malicious",
            "suspicious",
            "benign",
            "inconclusive",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "technical_summary": {
          "type": "string"
        },
        "highest_value_resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "remaining_decision_point": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "finding_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "original_claims",
          "final_status",
          "final_confidence",
          "evidence_chain",
          "reasoning",
          "confidence_change",
          "report_disposition",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "original_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "finding_id",
                "claim",
                "confidence"
              ],
              "properties": {
                "stage": {
                  "type": "string"
                },
                "finding_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "claim": {
                  "type": "string"
                },
                "confidence": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "final_status": {
            "enum": [
              "confirmed",
              "partial",
              "contradicted",
              "rejected",
              "not_reproduced",
              "unknown"
            ]
          },
          "final_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_chain": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "reasoning": {
            "type": "string"
          },
          "confidence_change": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "direction",
              "previous_max",
              "new",
              "justification"
            ],
            "properties": {
              "direction": {
                "enum": [
                  "increased",
                  "decreased",
                  "unchanged",
                  "rejected"
                ]
              },
              "previous_max": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "new": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "justification": {
                "type": "string"
              }
            }
          },
          "report_disposition": {
            "enum": [
              "include_confirmed",
              "include_with_caveat",
              "exclude",
              "include_as_unknown"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "claims",
          "analysis",
          "resolution",
          "resolved",
          "final_confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "claim"
              ],
              "properties": {
                "stage": {
                  "type": "string"
                },
                "claim": {
                  "type": "string"
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "analysis": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          },
          "resolved": {
            "type": "boolean"
          },
          "final_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "confidence",
          "supporting_evidence_ids",
          "counter_evidence_ids",
          "validation_plan",
          "falsification_condition",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "supporting_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counter_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation_plan": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "falsification_condition": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "supported",
              "weakened",
              "rejected",
              "validated"
            ]
          }
        }
      }
    },
    "root_cause_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "problem",
          "candidate_causes",
          "most_likely_cause",
          "confidence",
          "evidence_gap"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "candidate_causes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cause",
                "likelihood",
                "reason"
              ],
              "properties": {
                "cause": {
                  "type": "string"
                },
                "likelihood": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "most_likely_cause": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_gap": {
            "type": "string"
          }
        }
      }
    },
    "investigation_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "final_claim_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_claims",
        "caveated_claims",
        "prohibited_claims"
      ],
      "properties": {
        "allowed_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caveated_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "upstream_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "artifact",
        "location"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "observation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "static",
            "dynamic",
            "memory",
            "artifact",
            "tool_output",
            "external",
            "analyst"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "observation": {
          "type": "string"
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "status",
        "confidence",
        "description",
        "reasoning",
        "sources",
        "evidence",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "enum": [
            "sample_identity",
            "packing",
            "loader",
            "execution",
            "anti_analysis",
            "persistence",
            "filesystem",
            "registry",
            "process",
            "injection",
            "network",
            "credential_access",
            "collection",
            "exfiltration",
            "impact",
            "configuration",
            "ioc",
            "other"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "confirmed",
            "partial",
            "inferred",
            "hypothesized",
            "not_observed",
            "contradicted",
            "rejected",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "description": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "target",
        "reason",
        "recommended_action",
        "success_criteria"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "target": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "recommended_action": {
          "type": "string"
        },
        "success_criteria": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "type",
        "validation_status",
        "context"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "type": {
          "type": "string"
        },
        "validation_status": {
          "enum": [
            "validated",
            "partial",
            "failed",
            "not_validated",
            "not_applicable"
          ]
        },
        "context": {
          "type": "string"
        }
      }
    }
  }
}