{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HyperAgent Pipeline Orchestration State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp_utc",
    "sample_sha256",
    "input_path",
    "report_dir",
    "current_stage_id",
    "last_error",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "timestamp_utc": {
      "type": "string"
    },
    "sample_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "input_path": {
      "type": "string"
    },
    "report_dir": {
      "type": "string"
    },
    "current_stage_id": {
      "$ref": "#/$defs/stage_id"
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommend_next_stage": {
      "$ref": "#/$defs/recommend_next_stage"
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "01-prepare-env": {
          "$ref": "#/$defs/stage_entry"
        },
        "02-static-pass1": {
          "$ref": "#/$defs/stage_entry"
        },
        "03-unpack": {
          "$ref": "#/$defs/stage_entry"
        },
        "04-static-pass2": {
          "$ref": "#/$defs/stage_entry"
        },
        "05-dynamic": {
          "$ref": "#/$defs/stage_entry"
        },
        "06-intel": {
          "$ref": "#/$defs/stage_entry"
        },
        "07-deepdive": {
          "$ref": "#/$defs/stage_entry"
        },
        "08-report": {
          "$ref": "#/$defs/stage_entry"
        },
        "09-summary": {
          "$ref": "#/$defs/stage_entry"
        }
      }
    }
  },
  "$defs": {
    "stage_id": {
      "enum": [
        "01-prepare-env",
        "02-static-pass1",
        "03-unpack",
        "04-static-pass2",
        "05-dynamic",
        "06-intel",
        "07-deepdive",
        "08-report",
        "09-summary"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "completed"
      ]
    },
    "recommend_action": {
      "enum": [
        "resume_current",
        "run_next",
        "retry_stage",
        "pipeline_complete"
      ]
    },
    "recommend_next_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "stage_id",
        "skill",
        "source_stage_id",
        "reason",
        "progress_path"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/recommend_action"
        },
        "stage_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_stage_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "progress_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stage_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "status",
        "output_path",
        "progress_path",
        "updated_at"
      ],
      "properties": {
        "skill": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "output_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
